# Kopiere zu .env und trage deine Werte ein.
# Diese Datei ist nur als Vorlage gedacht — .env nicht committen!

# Vollständige Domain, die Caddy bedienen soll.
# Beispiel: schulwissen-labyrinth.duckdns.org
DOMAIN=schulwissen-labyrinth.duckdns.org

# Subdomain ohne ".duckdns.org" — wie auf https://www.duckdns.org registriert.
DUCKDNS_SUBDOMAIN=schulwissen-labyrinth

# Token von https://www.duckdns.org/ (nach Login oben sichtbar).
DUCKDNS_TOKEN=00000000-0000-0000-0000-000000000000
